<?xml version='1.0' ?>
<sdf version='1.6'>
  <world name='magtest'>
    <plugin name='mavlink_interface' filename='libgazebo_mavlink_interface.so'>
      <modelNamespace>iris_fpv_cam</modelNamespace>
      <heartbeat_rate>1</heartbeat_rate>
      <speedup>1</speedup>
      <protocol_version>2</protocol_version>
      <use_tcp>0</use_tcp>
      <lat>0</lat>
      <lon>0</lon>
      <alt>0</alt>
    </plugin>
    <include>
      <uri>model://iris</uri>
      <static>false</static>
    </include>
    <include>
      <uri>model://fpv_cam</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <joint name="fpv_cam_joint" type="fixed">
      <child>fpv_cam::link</child>
      <parent>iris::base_link</parent>
    </joint>
    <physics name='1ms' type='ode'>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <light name='sun' type='directional'>
      <pose>5 -5 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
  </world>
</sdf>
