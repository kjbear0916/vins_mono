<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="light_medium">

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Medium illumination: moderate directional + dimmed ambient -->
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <specular>0.6 0.6 0.6 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.7</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <light type="ambient" name="ambient_medium">
      <ambient>0.4 0.4 0.4 1</ambient>
    </light>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <wind>
      <vertical_velocity>0</vertical_velocity>
    </wind>

    <gravity>0 0 -9.81</gravity>
    <magnetic_field>0 0 0</magnetic_field>

  </world>
</sdf>
