# Fly-inspired (LPLC2) looming collision threat from the front camera.
# score:      0..1 aggregated looming strength (leaky-integrated population vote)
# azimuth:    threat direction in the camera frame, rad; 0 = straight ahead, + = right
# elevation:  threat direction in the camera frame, rad; + = up
# expansion:  normalized radial expansion (divergence) rate of the threat patch
float32 score
float32 azimuth
float32 elevation
float32 expansion