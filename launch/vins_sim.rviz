Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views

Visualization Manager:
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Relative Line Width: 1
      Line Style: Lines
      Cell Size: 1
      Color: 160; 160; 164
      Enabled: true
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
    - Class: rviz/Path
      Name: VINS Path (estimated)
      Enabled: true
      Topic: /vins_estimator/path
      Color: 255; 85; 0
      Line Style: Lines
      Thickness: 3
    - Class: rviz/Path
      Name: Ground Truth (Gazebo)
      Enabled: true
      Topic: /gazebo/model_states_gt  # requires remap script
      Color: 0; 170; 255
      Line Style: Lines
      Thickness: 3
    - Class: rviz/PointStamped
      Name: Current Estimate
      Enabled: true
      Topic: /vins_estimator/odometry
      Color: 255; 0; 0

Global Options:
  Background Color: 48; 48; 48
  Fixed Frame: world
  Frame Rate: 30

Views:
  Current:
    Class: rviz/Orbit
    Distance: 20
    Focal Point: 0; 0; 3
    Target Frame: world