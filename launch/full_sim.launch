<launch>
  <!-- Full simulation pipeline: PX4 SITL + camera + VINS -->

  <arg name="world" default="light_high"/>
  <arg name="config_file" default="$(find vins_research)/config/sim_config.yaml"/>
  <arg name="x" default="0"/>
  <arg name="y" default="0"/>
  <arg name="z" default="0"/>
  <arg name="R" default="0"/>
  <arg name="P" default="0"/>
  <arg name="Y" default="0"/>

  <!-- PX4 SITL -->
  <include file="$(find px4_sim)/launch/px4_multi_agent.launch">
    <arg name="vehicle" value="iris"/>
    <arg name="world" value="$(arg world)"/>
    <arg name="x" value="$(arg x)"/>
    <arg name="y" value="$(arg y)"/>
    <arg name="z" value="$(arg z)"/>
    <arg name="R" value="$(arg R)"/>
    <arg name="P" value="$(arg P)"/>
    <arg name="Y" value="$(arg Y)"/>
  </include>

  <!-- MAVROS -->
  <node pkg="mavros" type="mavros_node" name="mavros" output="screen">
    <param name="fcu_url" value="udp://:14556@localhost:14557"/>
    <param name="gcs_url" value=""/>
    <param name="target_system" value="1"/>
    <param name="target_component" value="1"/>
    <param name="fcu_protocol" value="v2.0"/>
    <param name="heartbeat_rate" value="1.0"/>
    <param name="system_rate" value="1.0"/>
    <param name="component_rate" value="1.0"/>
    <param name="stream_timesync_rate" value="10.0"/>
  </node>

  <!-- VINS-Mono -->
  <include file="$(find vins_mono)/launch/vins_mono.launch">
    <arg name="config_file" value="$(arg config_file)"/>
  </include>

  <!-- RViz -->
  <node pkg="rviz" type="rviz" name="rviz"
        args="-d $(find vins_research)/launch/vins_sim.rviz"/>

</launch>
