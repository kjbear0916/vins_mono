<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="light_high">
    <scene>
      <ambient>0.8 0.8 0.8 1.0</ambient>
      <background>0.7 0.7 0.7 1.0</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.4 0.4 0.4 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <uri>model://asphalt_plane</uri>
    </include>
    <include>
      <uri>model://vins_props</uri>
    </include>
    <model name='towers'>
      <static>true</static>
      <link name='link'>
        <inertial>
          <mass>0.001</mass>
          <inertia>
            <ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
          </inertia>
        </inertial>
        <visual name='t0'><pose>7 0 3.5 0 0 0</pose><geometry><box><size>1.5 1.5 7</size></box></geometry><material><script>Gazebo/Red</script></material></visual>
        <visual name='t1'><pose>-7 0 4.0 0 0 0</pose><geometry><box><size>1.5 1.5 8</size></box></geometry><material><script>Gazebo/Green</script></material></visual>
        <visual name='t2'><pose>0 7 3.0 0 0 0</pose><geometry><box><size>1.5 1.5 6</size></box></geometry><material><script>Gazebo/Blue</script></material></visual>
        <visual name='t3'><pose>0 -7 4.5 0 0 0</pose><geometry><box><size>1.5 1.5 9</size></box></geometry><material><script>Gazebo/Yellow</script></material></visual>
        <visual name='t4'><pose>5 5 2.75 0 0 0</pose><geometry><box><size>1.2 1.2 5.5</size></box></geometry><material><script>Gazebo/Cyan</script></material></visual>
        <visual name='t5'><pose>-5 5 3.75 0 0 0</pose><geometry><box><size>1.2 1.2 7.5</size></box></geometry><material><script>Gazebo/Orange</script></material></visual>
        <visual name='t6'><pose>5 -5 3.25 0 0 0</pose><geometry><box><size>1.2 1.2 6.5</size></box></geometry><material><script>Gazebo/Purple</script></material></visual>
        <visual name='t7'><pose>-5 -5 4.25 0 0 0</pose><geometry><box><size>1.2 1.2 8.5</size></box></geometry><material><script>Gazebo/Grey</script></material></visual>
        <visual name='t8'><pose>10 3 3.0 0 0 0</pose><geometry><box><size>2 2 6</size></box></geometry><material><script>Gazebo/DarkGreen</script></material></visual>
        <visual name='t9'><pose>-10 3 3.5 0 0 0</pose><geometry><box><size>2 2 7</size></box></geometry><material><script>Gazebo/DarkGrey</script></material></visual>
        <visual name='t10'><pose>3 10 2.5 0 0 0</pose><geometry><box><size>2 2 5</size></box></geometry><material><script>Gazebo/Teal</script></material></visual>
        <visual name='t11'><pose>-3 -10 4.0 0 0 0</pose><geometry><box><size>2 2 8</size></box></geometry><material><script>Gazebo/Red</script></material></visual>
      </link>
    </model>

    <physics name='default_physics' default='0' type='ode'>
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>10</iters>
          <sor>1.3</sor>
          <use_dynamic_moi_rescaling>0</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    </physics>
  </world>
</sdf>
